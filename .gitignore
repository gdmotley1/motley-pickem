# cfb-pickem

# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*credential*
*secret*

# --- Claude Code -----------------------------------------------------------
# settings.json (curated, shared) is versioned. Machine-local grants never are:
# that file accumulates approved commands verbatim and can capture credentials.
.claude/*
!.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# --- data and deliverables -------------------------------------------------
# All reproducible: re-pullable from source or regenerated by a build script.
data/
exports/
*.log

# --- python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# --- node ------------------------------------------------------------------
node_modules/

# --- build output ----------------------------------------------------------
# Regenerated by `npm run build`; GitHub Actions builds it in CI.
dist/
outputs/
